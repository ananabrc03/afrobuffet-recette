---
interface Props { ingredients: string[] }
const { ingredients } = Astro.props;
---

<section class="recipe-section ingredient-section" aria-labelledby="ingredients-title">
  <h2 id="ingredients-title">Ingrédients</h2>
  <ul class="ingredient-list">
    {ingredients.map((ingredient) => <li>{ingredient}</li>)}
  </ul>
</section>
