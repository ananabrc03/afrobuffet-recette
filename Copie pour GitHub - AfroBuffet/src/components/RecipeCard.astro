---
import { Picture } from 'astro:assets';
import type { Recipe } from '../lib/data';
import { getRecipeImage } from '../lib/data';
import Icon from './Icon.astro';

interface Props {
  recipe: Recipe;
  compact?: boolean;
  eager?: boolean;
}

const { recipe, compact = false, eager = false } = Astro.props;
const image = getRecipeImage(recipe);
---

<a
  class:list={['recipe-card', { 'recipe-card--compact': compact }]}
  href={`/recettes/${recipe.slug}/`}
  aria-label={`${recipe.name} — voir la recette`}
>
  <span class="recipe-card__image-wrap">
    <Picture
      src={image}
      formats={['avif']}
      fallbackFormat="webp"
      alt={recipe.image.alt}
      widths={compact ? [160, 240, 320] : [200, 320, 440]}
      sizes={compact ? '(max-width: 599px) 42vw, 220px' : '(max-width: 599px) 72vw, 190px'}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      width={image.width}
      height={image.height}
    />
  </span>
  <span class="recipe-card__body">
    <strong class="recipe-card__title">{recipe.name}</strong>
    {!compact && (
      <span class="recipe-card__time">
        <Icon name="cuisson" />
        <span>{recipe.times.cardTotalActive.display}</span>
      </span>
    )}
    <span class="recipe-card__cta">Voir la recette</span>
  </span>
</a>
