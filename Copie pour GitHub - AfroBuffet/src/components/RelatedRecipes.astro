---
import type { Recipe } from '../lib/data';
import RecipeRail from './RecipeRail.astro';
interface Props { recipes: Recipe[]; currentSlug: string }
const { recipes, currentSlug } = Astro.props;
---

<section class="related" aria-labelledby="related-title" data-print-hidden>
  <h2 id="related-title">Voir aussi</h2>
  <RecipeRail recipes={recipes} id={`related-${currentSlug}`} compact />
</section>
