---
import type { TimeBadge } from '../lib/data';
import Icon from './Icon.astro';

interface Props { badges: TimeBadge[] }
const { badges } = Astro.props;
---

<dl class="time-badges">
  {badges.map((badge) => (
    <div class="time-badge">
      <dt><Icon name={badge.icon} /><span>{badge.label}</span></dt>
      <dd>{badge.value}</dd>
    </div>
  ))}
</dl>
