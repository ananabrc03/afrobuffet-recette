{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afrobuffet.fr/schemas/afrobuffet-data.schema.json",
  "title": "Données du site AfroBuffet",
  "type": "object",
  "required": [
    "site",
    "fonts",
    "icons",
    "families",
    "recipes"
  ],
  "properties": {
    "site": {
      "type": "object"
    },
    "fonts": {
      "type": "object"
    },
    "icons": {
      "type": "string"
    },
    "families": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7
    },
    "recipes": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "familyId",
          "countryRegion",
          "origin",
          "servings",
          "difficulty",
          "times",
          "utensils",
          "ingredients",
          "steps",
          "anecdote",
          "alternativeRecipes",
          "relatedRecipes",
          "image",
          "seo"
        ]
      }
    }
  }
}