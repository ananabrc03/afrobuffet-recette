---
import BaseLayout from '../layouts/BaseLayout.astro';
import FamilyAccordion from '../components/FamilyAccordion.astro';
import { assertPilotData, data, PILOT_FAMILY, pilotRecipes } from '../lib/data';

assertPilotData();
const families = [...data.families].sort((a, b) => a.order - b.order);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'AfroBuffet',
    url: 'https://afrobuffet.fr/',
    inLanguage: 'fr',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    numberOfItems: pilotRecipes.length,
    itemListElement: pilotRecipes.map((recipe, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: recipe.name,
      url: `https://afrobuffet.fr/recettes/${recipe.slug}/`,
    })),
  },
];
---

<BaseLayout
  title="Les recettes AfroBuffet"
  description={data.site.homeIntro}
  canonicalPath="/"
  structuredData={structuredData}
>
  <section class="home-intro">
    <h1>Les recettes</h1>
    <p>{data.site.homeIntro}</p>
  </section>

  <section class="families" id="recettes" aria-label="Familles de recettes">
    {families.map((family) => (
      <FamilyAccordion
        family={family}
        recipes={family.id === PILOT_FAMILY ? pilotRecipes : []}
        enabled={family.id === PILOT_FAMILY}
      />
    ))}
  </section>
</BaseLayout>
