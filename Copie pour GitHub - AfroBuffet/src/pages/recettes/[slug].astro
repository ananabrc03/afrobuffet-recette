---
import RecipeLayout from '../../layouts/RecipeLayout.astro';
import {
  assertPilotData,
  getFamily,
  getPilotRelated,
  pilotRecipes,
  type Recipe,
} from '../../lib/data';

export function getStaticPaths() {
  assertPilotData();
  return pilotRecipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

interface Props { recipe: Recipe }
const { recipe } = Astro.props;
const family = getFamily(recipe.familyId);
const related = getPilotRelated(recipe);
---

<RecipeLayout recipe={recipe} family={family} related={related} />
